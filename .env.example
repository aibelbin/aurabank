# The bank's first *member* account, read once when there are no members yet.
# The reserve (account #0001, holding 1,000,000) is opened automatically and is
# not a person: citations are paid out of it, which is what keeps issuing aura
# a transfer rather than a number appearing from nowhere.
#
# An invite code needs an issuer, an issuer needs an account, and an account
# needs a code — something has to start outside that loop. These do. Copy this
# file to `.env`, set a real password, and bring the stack up. Leaving them set
# afterwards does nothing, and changing them does not change an existing
# password.
# The username signed in with. Unique, and letters/digits/. _ - only.
BANK_JUDGE_HANDLE=A_Zacariah
# What the bench is actually called, shown at the head of a statement.
BANK_JUDGE_NAME=Aibel Bin Zacariah
BANK_JUDGE_EMAIL=you@example.com
BANK_JUDGE_PASSWORD=change-this-to-something-long
# Account number. #0007 for the bench; the reserve takes #0001 automatically.
BANK_JUDGE_ID=7
